-- Migration 1 -> 2: adds the WalletConnect session store.
-- Version 1 is the original schema (wallets, accounts, utxos, transactions);
-- version 2 is the current schema. The DDL must match the wc_sessions table in
-- CoinSafeBoxDatabase.sq exactly so the schema produced by create() and by this
-- migration are identical.
CREATE TABLE wc_sessions (
    topic TEXT PRIMARY KEY NOT NULL,
    pairing_topic TEXT NOT NULL,
    proposer_public_key TEXT NOT NULL,
    proposer_metadata TEXT NOT NULL,
    responder_public_key TEXT NOT NULL,
    responder_metadata TEXT NOT NULL,
    namespaces TEXT NOT NULL,
    expiry INTEGER NOT NULL,
    acknowledged INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    settle_request_id INTEGER
);
